<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Gestión de Usuarios (Offline / Online)"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Formulario de Registro con matricula, password y nombre -->
        <EditText
            android:id="@+id/etMatriculaUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Matrícula del Usuario"
            android:inputType="text" />

        <EditText
            android:id="@+id/etPasswordUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etNombreUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre Completo"
            android:inputType="textPersonName"
            android:layout_marginTop="8dp" />

        <!-- Botón Guardar Local -->
        <Button
            android:id="@+id/btnGuardarLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Localmente (SQLite)"
            android:layout_marginTop="12dp" />

        <!-- Botón Sincronizar Servidor -->
        <Button
            android:id="@+id/btnSincronizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sincronizar con Servidor"
            android:backgroundTint="#2E7D32"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lista de Usuarios Guardados:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

        <ListView
            android:id="@+id/lvUsuarios"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>